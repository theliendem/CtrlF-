{
  "name": "ctrlf-plus-plus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import ./scripts/register-tests.mjs --test tests/*.test.ts",
    "dev": "node scripts/fetch-assets.mjs && vite build --watch --mode firefox",
    "build": "npm run build:firefox",
    "typecheck": "tsc --noEmit",
    "dev:chrome": "vite --mode chrome",
    "build:firefox": "node scripts/fetch-assets.mjs && tsc --noEmit && vite build --mode firefox",
    "build:chrome": "node scripts/fetch-assets.mjs && tsc --noEmit && vite build --mode chrome",
    "build:all": "npm run build:firefox && npm run build:chrome",
    "eval:semantic": "node scripts/fetch-assets.mjs && node --import ./scripts/register-tests.mjs scripts/eval-semantic.mjs",
    "test:models": "node scripts/fetch-assets.mjs && node --import ./scripts/register-tests.mjs --test tests/model-integration.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.7",
    "@xmldom/xmldom": "^0.9.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "jszip": "^3.10.2",
    "onnxruntime-web": "^1.31.0-dev.20260914-8d85527a0",
    "pdfjs-dist": "^6.5.438"
  }
}
